{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vorssaint.utils",
  "productName": "Vorssaint",
  "directories": {
    "output": "dist-vorssaint"
  },
  "extraMetadata": {
    "main": "src/vorssaint/standalone.js"
  },
  "files": [
    "src/vorssaint/**/*",
    "src/main/vorssaint/**/*",
    "src/renderer/vorssaint_menu_panel.html",
    "src/renderer/vorssaint_hub.html",
    "src/renderer/island.html",
    "src/renderer/island.js",
    "src/renderer/mascot_rig.js",
    "src/renderer/mascot_rig.css",
    "src/renderer/cleaning_mode.html",
    "src/renderer/command_bar.html",
    "src/renderer/assets/**/*",
    "src/main/preload.js",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Vorssaint"
  }
}
