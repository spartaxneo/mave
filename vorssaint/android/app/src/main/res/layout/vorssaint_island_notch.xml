<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Compact Notch Capsule (Screenshot 2) -->
    <LinearLayout
        android:id="@+id/compact_notch"
        android:layout_width="240dp"
        android:layout_height="38dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_notch_compact"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Authentic White Pearl Mascot -->
        <FrameLayout
            android:id="@+id/mascot_face"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/mascot_pearl_circle">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">
                <View
                    android:layout_width="3.5dp"
                    android:layout_height="8dp"
                    android:background="#09090b"
                    android:layout_marginEnd="3dp" />
                <View
                    android:layout_width="3.5dp"
                    android:layout_height="8dp"
                    android:background="#09090b" />
            </LinearLayout>
        </FrameLayout>

        <!-- Camera Cutout Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/camera_lens_circle" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Audio Wave Bars -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:orientation="horizontal"
            android:gravity="bottom">
            <View android:layout_width="2.5dp" android:layout_height="8dp" android:background="#ffffff" android:layout_marginEnd="2dp" />
            <View android:layout_width="2.5dp" android:layout_height="12dp" android:background="#ffffff" android:layout_marginEnd="2dp" />
            <View android:layout_width="2.5dp" android:layout_height="6dp" android:background="#ffffff" />
        </LinearLayout>
    </LinearLayout>

    <!-- Expanded Controls Card (Screenshot 1) -->
    <LinearLayout
        android:id="@+id/expanded_controls"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:visibility="gone"
        android:background="@drawable/bg_controls_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Controls Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controls"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Middle Grid: Media & Sliders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Media Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#161618"
                android:padding="10dp"
                android:orientation="horizontal"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#09090b"
                    android:gravity="center"
                    android:text="♫"
                    android:textColor="#a1a1aa"
                    android:textSize="16sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nothing playing"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Music controls"
                        android:textColor="#71717a"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sliders Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#161618"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <SeekBar
                    android:id="@+id/vol_seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="45" />
                <SeekBar
                    android:id="@+id/bright_seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="65"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔊 Mixer"
                android:textColor="#a1a1aa"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/btn_keep_awake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☕ Awake"
                android:textColor="#a1a1aa"
                android:textSize="11sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⏱ Timer"
                android:textColor="#a1a1aa"
                android:textSize="11sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📅 Calendar"
                android:textColor="#a1a1aa"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
