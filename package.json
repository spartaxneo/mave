{
  "name": "mave",
  "productName": "Mave",
  "version": "1.4.8",
  "description": "An AI assistant that lives next to your cursor, sees your screen, talks, and operates your computer.",
  "main": "src/main/main.js",
  "author": "jhmeel",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhmeel/bigfoot.git"
  },
  "homepage": "https://github.com/jhmeel/bigfoot#readme",
  "bugs": {
    "url": "https://github.com/jhmeel/bigfoot/issues"
  },
  "private": true,
  "scripts": {
    "build:native": "node scripts/build-native.js",
    "fetch:speech": "node scripts/fetch-speech.js",
    "prestart": "node scripts/build-native.js && node scripts/fetch-speech.js",
    "predist": "node scripts/build-native.js && node scripts/fetch-speech.js",
    "start": "electron .",
    "test": "node --test test/core.test.js test/agent.test.js test/local.test.js test/plugins.test.js test/speech-stream.test.js test/terminal.test.js test/media-plugins.test.js test/memory-and-models.test.js test/router.test.js test/jarvis-plugins.test.js test/remote.test.js test/superpowers.test.js test/meta_orchestrator.test.js test/airllm.test.js test/diagnostics.test.js test/pinchtab.test.js test/anti_hallucination_and_connected_services.test.js test/privacy_threads_devices_video.test.js test/speaker_voice_interruption.test.js test/remote_hands.test.js test/governance.test.js",

    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "loopback-capture": "^3.0.2",
    "nerdamer-prime": "^1.5.0",
    "onnxruntime-node": "1.21.0",
    "phonemizer": "1.2.1",
    "svg-path-properties": "^2.1.0"
  },
  "devDependencies": {
    "@tabler/icons": "^3.48.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.mave.app",
    "productName": "Mave",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.cs",
      "!node_modules/onnxruntime-node/bin/napi-v3/{linux,darwin}/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
    ],
    "extraResources": [
      {
        "from": "vendor/speech",
        "to": "speech"
      },
      {
        "from": "vendor/math",
        "to": "math"
      },
      {
        "from": "vendor/voice",
        "to": "voice"
      }
    ],
    "asarUnpack": [
      "src/main/native/**",
      "src/main/plugins/validate-child.js",
      "node_modules/onnxruntime-node/bin/**",
      "node_modules/@lydell/node-pty-win32-x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mave",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Mave",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "artifactName": "Mave-Setup-${version}.${ext}"
  }
}
